{
  "version": 3,
  "deployment": {
    "id": "dark-local-ha",
    "label": "dARK local high-availability simulation"
  },
  "defaults": {
    "ssh": {
      "user": "dark",
      "port": 22,
      "private_key_file": "/tmp/not-used-local.key"
    },
    "paths": {
      "workspace_root": "/srv/dark",
      "data_root": "/srv/dark/data",
      "secrets_root": "/srv/dark/secrets"
    },
    "docker": {
      "subnet_pool": "172.30.0.0/16",
      "subnet_prefix": 24
    }
  },
  "networks": {
    "lab": {
      "kind": "lan",
      "cidr": "10.99.0.0/24"
    }
  },
  "machines": {
    "local": {
      "execution": "local",
      "management_address": "127.0.0.1",
      "addresses": {
        "lab": "10.99.0.10"
      }
    }
  },
  "groups": {
    "apps": {
      "kind": "apps",
      "machine": "local",
      "members": ["rpc01"],
      "services": ["admin-api", "chain-worker", "contracts-deploy", "dashboard", "dashboard-migrate", "dashboard-mysql", "dashboard-redis", "edge-proxy", "explorer", "metadata-worker", "minter-api", "minter-migrate", "minter-postgres", "replication-worker", "resolver-api", "rpc01", "store-api"]
    },
    "blockchain-a": {
      "kind": "validators",
      "machine": "local",
      "members": ["validator01", "validator02"],
      "services": ["validator01", "validator02"]
    },
    "blockchain-b": {
      "kind": "validators",
      "machine": "local",
      "members": ["validator03", "validator04"],
      "services": ["validator03", "validator04"]
    },
    "storage-1": {
      "kind": "storage",
      "machine": "local",
      "members": ["storage-a"],
      "services": ["ipfs-storage-a", "cluster-storage-a"]
    },
    "storage-2": {
      "kind": "storage",
      "machine": "local",
      "members": ["storage-b"],
      "services": ["ipfs-storage-b", "cluster-storage-b"]
    }
  },
  "services": {
    "rpc01": {
      "type": "besu-rpc",
      "machine": "local",
      "configuration": {
        "node_id": "rpc01"
      }
    },
    "validator01": {
      "type": "besu-validator",
      "machine": "local",
      "configuration": {
        "node_id": "validator01"
      }
    },
    "validator02": {
      "type": "besu-validator",
      "machine": "local",
      "configuration": {
        "node_id": "validator02"
      }
    },
    "validator03": {
      "type": "besu-validator",
      "machine": "local",
      "configuration": {
        "node_id": "validator03"
      }
    },
    "validator04": {
      "type": "besu-validator",
      "machine": "local",
      "configuration": {
        "node_id": "validator04"
      }
    },
    "explorer": {
      "type": "explorer",
      "machine": "local",
      "connections": {
        "rpc": {
          "service": "rpc01"
        }
      }
    },
    "minter-postgres": {
      "type": "minter-postgres",
      "machine": "local"
    },
    "minter-migrate": {
      "type": "minter-migrate",
      "machine": "local",
      "connections": {
        "database": {
          "service": "minter-postgres"
        }
      }
    },
    "store-api": {
      "type": "store-api",
      "machine": "local",
      "connections": {
        "cluster_cluster-storage-a": {
          "service": "cluster-storage-a"
        },
        "cluster_cluster-storage-b": {
          "service": "cluster-storage-b"
        }
      }
    },
    "minter-api": {
      "type": "minter-api",
      "machine": "local",
      "connections": {
        "database": {
          "service": "minter-postgres"
        },
        "store_api": {
          "service": "store-api"
        },
        "rpc": {
          "service": "rpc01"
        },
        "contracts": {
          "service": "contracts-deploy"
        },
        "migration": {
          "service": "minter-migrate"
        }
      },
      "exposure": {
        "mode": "loopback",
        "port": 8001
      }
    },
    "metadata-worker": {
      "type": "minter-worker",
      "machine": "local",
      "configuration": {
        "worker": "metadata"
      },
      "connections": {
        "database": {
          "service": "minter-postgres"
        },
        "store_api": {
          "service": "store-api"
        },
        "rpc": {
          "service": "rpc01"
        },
        "contracts": {
          "service": "contracts-deploy"
        },
        "migration": {
          "service": "minter-migrate"
        }
      }
    },
    "replication-worker": {
      "type": "minter-worker",
      "machine": "local",
      "configuration": {
        "worker": "replication"
      },
      "connections": {
        "database": {
          "service": "minter-postgres"
        },
        "store_api": {
          "service": "store-api"
        },
        "rpc": {
          "service": "rpc01"
        },
        "contracts": {
          "service": "contracts-deploy"
        },
        "migration": {
          "service": "minter-migrate"
        }
      }
    },
    "chain-worker": {
      "type": "minter-worker",
      "machine": "local",
      "configuration": {
        "worker": "chain"
      },
      "connections": {
        "database": {
          "service": "minter-postgres"
        },
        "store_api": {
          "service": "store-api"
        },
        "rpc": {
          "service": "rpc01"
        },
        "contracts": {
          "service": "contracts-deploy"
        },
        "migration": {
          "service": "minter-migrate"
        }
      }
    },
    "admin-api": {
      "type": "admin-api",
      "machine": "local",
      "connections": {
        "rpc": {
          "service": "rpc01"
        },
        "contracts": {
          "service": "contracts-deploy"
        }
      }
    },
    "resolver-api": {
      "type": "resolver-api",
      "machine": "local",
      "connections": {
        "rpc": {
          "service": "rpc01"
        },
        "store_api": {
          "service": "store-api"
        },
        "contracts": {
          "service": "contracts-deploy"
        }
      }
    },
    "dashboard-mysql": {
      "type": "dashboard-mysql",
      "machine": "local"
    },
    "dashboard-redis": {
      "type": "dashboard-redis",
      "machine": "local"
    },
    "dashboard-migrate": {
      "type": "dashboard-migrate",
      "machine": "local",
      "connections": {
        "database": {
          "service": "dashboard-mysql"
        },
        "redis": {
          "service": "dashboard-redis"
        },
        "admin_api": {
          "service": "admin-api"
        },
        "minter_api": {
          "service": "minter-api"
        },
        "resolver_api": {
          "service": "resolver-api"
        },
        "store_api": {
          "service": "store-api"
        }
      }
    },
    "dashboard": {
      "type": "dashboard",
      "machine": "local",
      "connections": {
        "database": {
          "service": "dashboard-mysql"
        },
        "redis": {
          "service": "dashboard-redis"
        },
        "admin_api": {
          "service": "admin-api"
        },
        "minter_api": {
          "service": "minter-api"
        },
        "resolver_api": {
          "service": "resolver-api"
        },
        "store_api": {
          "service": "store-api"
        },
        "migration": {
          "service": "dashboard-migrate"
        }
      }
    },
    "ipfs-storage-a": {
      "type": "ipfs-kubo",
      "machine": "local",
      "configuration": {
        "peer_name": "storage-a"
      }
    },
    "cluster-storage-a": {
      "type": "ipfs-cluster",
      "machine": "local",
      "configuration": {
        "peer_name": "storage-a"
      },
      "connections": {
        "kubo": {
          "service": "ipfs-storage-a"
        }
      }
    },
    "ipfs-storage-b": {
      "type": "ipfs-kubo",
      "machine": "local",
      "configuration": {
        "peer_name": "storage-b"
      }
    },
    "cluster-storage-b": {
      "type": "ipfs-cluster",
      "machine": "local",
      "configuration": {
        "peer_name": "storage-b"
      },
      "connections": {
        "kubo": {
          "service": "ipfs-storage-b"
        }
      }
    },
    "edge-proxy": {
      "type": "edge-proxy",
      "machine": "local",
      "connections": {
        "resolver": {"service": "resolver-api"}, "dashboard": {"service": "dashboard"},
        "explorer": {"service": "explorer"}, "minter": {"service": "minter-api"}
      },
      "configuration": {
        "tls": {"mode": "http"},
        "sites": [{"host": "localhost", "public_origin": "http://localhost", "routes": [
          {"id": "dashboard", "path": "/admin/", "connection": "dashboard", "upstream_path": "/"},
          {"id": "explorer", "path": "/explorer/", "connection": "explorer", "upstream_path": "/"},
          {"id": "minter-v1", "path": "/api/v1/", "connection": "minter", "upstream_path": "/api/v1/"},
          {"id": "minter-docs", "path": "/api/docs", "connection": "minter", "upstream_path": "/docs"},
          {"id": "minter-openapi", "path": "/api/openapi.json", "connection": "minter", "upstream_path": "/openapi.json"},
          {"id": "resolver", "path": "/", "connection": "resolver", "upstream_path": "/api/v1/arks/"}
        ]}]
      },
      "exposure": {"mode": "loopback", "port": 80, "protocols": ["tcp"]}
    },
    "contracts-deploy": {
      "type": "contracts-deploy",
      "machine": "local",
      "connections": {
        "rpc": {
          "service": "rpc01"
        }
      }
    }
  },
  "blockchain": {
    "chain_id": 2025,
    "besu_image": "hyperledger/besu:26.6.1",
    "qbft": {
      "block_period_seconds": 6,
      "epoch_length": 30000,
      "request_timeout_seconds": 10
    },
    "artifact": {
      "path": "blockchain/role-artifact"
    },
    "nodes": {
      "rpc01": {
        "validator": false
      },
      "validator01": {
        "validator": true
      },
      "validator02": {
        "validator": true
      },
      "validator03": {
        "validator": true
      },
      "validator04": {
        "validator": true
      }
    }
  },
  "storage": {
    "cluster_name": "dark-local",
    "nodes": [
      "storage-a",
      "storage-b"
    ],
    "replication": {
      "publish_after_replicas": 1,
      "target_replicas": 2
    }
  },
  "components": {
    "dark-dapp": {
      "repository_url": "git@github.com:LA-Referencia-IOI/dark-dapp.git",
      "branch": "main"
    },
    "dark-explorador": {
      "repository_url": "git@github.com:LA-Referencia-IOI/dark-explorer.git",
      "branch": "main"
    },
    "dark-core-lib": {
      "repository_url": "git@github.com:LA-Referencia-IOI/dark-core-lib.git",
      "branch": "main"
    },
    "dark-core-admin-api": {
      "repository_url": "git@github.com:LA-Referencia-IOI/dark-core-admin-api.git",
      "branch": "main"
    },
    "dark-core-resolver-api": {
      "repository_url": "git@github.com:LA-Referencia-IOI/dark-core-resolver-api.git",
      "branch": "main"
    },
    "dark-store-api": {
      "repository_url": "git@github.com:LA-Referencia-IOI/dark-store-api.git",
      "branch": "main"
    },
    "dark-core-minter-api": {
      "repository_url": "git@github.com:LA-Referencia-IOI/dark-core-minter-api.git",
      "branch": "main"
    },
    "dashboard-web": {
      "repository_url": "git@github.com:LA-Referencia-IOI/dashboard-web.git",
      "branch": "main"
    },
    "dark-ipfs": {
      "repository_url": "git@github.com:LA-Referencia-IOI/dark-ipfs.git",
      "branch": "main"
    }
  },
  "settings": {
    "minter": {
      "shoulder": "200",
      "metadata": {
        "page_size": 100,
        "concurrency": 4,
        "min_concurrency": 2
      },
      "replication": {
        "enabled": true,
        "page_size": 100,
        "concurrency": 2,
        "status_batch_size": 200,
        "promotion_batch_size": 100,
        "promotion_pressure_high_percent": 80,
        "promotion_pressure_medium_percent": 50,
        "promotion_min_batch_size": 20,
        "maintenance_cycle_seconds": 5,
        "idle_sleep_seconds": 2,
        "first_pin_recheck_seconds": 15,
        "first_pin_second_recheck_seconds": 60,
        "first_pin_max_recheck_seconds": 300,
        "durability_recheck_seconds": 300,
        "durability_second_recheck_seconds": 900,
        "durability_max_recheck_seconds": 3600,
        "storage_retry_seconds": 10
      },
      "chain": {
        "page_size": 100,
        "rpc_batch_size": 50
      }
    },
    "store": {
      "add_concurrency": 4,
      "status_concurrency": 6,
      "promotion_concurrency": 4
    }
  },
  "secrets": {
    "master-wallet": {
      "path": "blockchain/master-wallet",
      "consumers": [],
      "mode": "0600"
    },
    "contract-signer": {
      "path": "blockchain/contract-signer",
      "consumers": [
        "contracts-deploy"
      ],
      "mode": "0600"
    },
    "ipfs-swarm-key": {
      "path": "ipfs/swarm.key",
      "consumers": [
        "ipfs-storage-a",
        "ipfs-storage-b"
      ],
      "mode": "0600"
    },
    "ipfs-cluster-secret": {
      "path": "ipfs/cluster.secret",
      "consumers": [
        "cluster-storage-a",
        "cluster-storage-b"
      ],
      "mode": "0600"
    },
    "minter-db-password": {
      "path": "minter/db-password",
      "consumers": [],
      "mode": "0600"
    },
    "minter-runtime-env": {
      "path": "runtime/minter.private.env",
      "consumers": [
        "minter-postgres",
        "minter-migrate",
        "minter-api",
        "metadata-worker",
        "replication-worker",
        "chain-worker",
        "admin-api"
      ],
      "mode": "0600"
    },
    "dashboard-runtime-env": {
      "path": "runtime/dashboard.private.env",
      "consumers": [
        "dashboard-mysql",
        "dashboard-migrate",
        "dashboard"
      ],
      "mode": "0600"
    }
  },
  "infrastructure": {
    "besu": {
      "network": "lab",
      "p2p_port_start": 30303,
      "rpc_port": 8545
    },
    "ipfs": {
      "network": "lab",
      "api_port": 5001,
      "swarm_port": 4001
    },
    "cluster": {
      "network": "lab",
      "api_port": 9094,
      "p2p_port": 9096
    },
    "web": {
      "http_port": 80
    }
  }
}
