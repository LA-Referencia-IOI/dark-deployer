        "role": "validator"
      },
      "validator04": {
        "p2p_port": 30303,
        "role": "validator"
      }
    },
    "observer_max_block_lag": 1,
    "primary_rpc": "rpc01",
    "qbft": {
      "block_period_seconds": 6,
      "epoch_length": 30000,
      "request_timeout_seconds": 10
