      "path": "blockchain/role-artifact",
      "source": "REPLACE/secrets/chain-artifact"
    },
    "chain_id": 2025,
    "nodes": {
      "observer01": {
        "p2p_port": 30303,
        "role": "observer"
      },
      "rpc01": {
        "p2p_port": 30303,
        "role": "rpc"
      },
      "validator01": {
        "p2p_port": 30303,
        "role": "validator"
      },
      "validator02": {
        "p2p_port": 30303,
