  "defaults": {
    "docker": {
      "subnet_pool": "172.30.0.0/16",
      "subnet_prefix": 24
    },
    "paths": {
      "data_root": "/srv/dark/data",
      "secrets_root": "/srv/dark/secrets",
      "workspace_root": "/srv/dark"
    },
    "ssh": {
      "port": 22,
      "private_key_file": "/etc/dark-deployer/ssh/REPLACE-deploy-ed25519",
      "user": "dark"
    }
  },
  "deployment": {
    "id": "dark-operator-production-six",
    "label": "REPLACE: dARK six-host deployment with dedicated Resolver"
  },
  "groups": {
    "apps": {
      "kind": "apps",
