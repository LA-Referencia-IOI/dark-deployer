{
  "format": "dark-operator-inventory",
  "format_version": 2,
  "catalog": "dark-platform-baseline-v1.0",
  "profile": "lab",
  "deployment": {
    "id": "dark-lima-five-host",
    "label": "dARK Lima five-host acceptance lab"
  },
  "defaults": {
    "ssh": {
      "user": "dark",
      "port": 22,
      "private_key_file": "/etc/dark-deployer/ssh/REPLACE-deploy-ed25519"
    },
    "paths": {
      "workspace_root": "/srv/dark",
      "data_root": "/srv/dark/data",
      "secrets_root": "/srv/dark/secrets"
    }
  },
  "networks": {
    "lab": {
      "kind": "lan",
      "cidr": "192.168.105.0/24"
    }
  },
  "machines": {
    "apps": {
      "execution": "ssh",
      "management_address": "127.0.0.1",
      "addresses": {
        "lab": "192.168.105.3"
      },
      "ssh": {
        "user": "lmatas",
        "port": 56957,
        "private_key_file": "/Volumes/Externo/dark-lab/.lima/_config/user",
        "known_hosts_file": "/Volumes/Externo/dark-lab/.lima/_config/dark-deployer-known_hosts"
      },
      "paths": {
        "workspace_root": "/home/lmatas.guest/dark",
        "data_root": "/home/lmatas.guest/dark-data",
        "secrets_root": "/home/lmatas.guest/dark-secrets"
      }
    },
    "blockchain-a": {
      "execution": "ssh",
      "management_address": "127.0.0.1",
      "addresses": {
        "lab": "192.168.105.4"
      },
      "ssh": {
        "user": "lmatas",
        "port": 56967,
        "private_key_file": "/Volumes/Externo/dark-lab/.lima/_config/user",
        "known_hosts_file": "/Volumes/Externo/dark-lab/.lima/_config/dark-deployer-known_hosts"
      },
      "paths": {
        "workspace_root": "/home/lmatas.guest/dark",
        "data_root": "/home/lmatas.guest/dark-data",
        "secrets_root": "/home/lmatas.guest/dark-secrets"
      }
    },
    "blockchain-b": {
      "execution": "ssh",
      "management_address": "127.0.0.1",
      "addresses": {
        "lab": "192.168.105.5"
      },
      "ssh": {
        "user": "lmatas",
        "port": 56976,
        "private_key_file": "/Volumes/Externo/dark-lab/.lima/_config/user",
        "known_hosts_file": "/Volumes/Externo/dark-lab/.lima/_config/dark-deployer-known_hosts"
      },
      "paths": {
        "workspace_root": "/home/lmatas.guest/dark",
        "data_root": "/home/lmatas.guest/dark-data",
        "secrets_root": "/home/lmatas.guest/dark-secrets"
      }
    },
    "storage-1": {
      "execution": "ssh",
      "management_address": "127.0.0.1",
      "addresses": {
        "lab": "192.168.105.6"
      },
      "ssh": {
        "user": "lmatas",
        "port": 56985,
        "private_key_file": "/Volumes/Externo/dark-lab/.lima/_config/user",
        "known_hosts_file": "/Volumes/Externo/dark-lab/.lima/_config/dark-deployer-known_hosts"
      },
      "paths": {
        "workspace_root": "/home/lmatas.guest/dark",
        "data_root": "/home/lmatas.guest/dark-data",
        "secrets_root": "/home/lmatas.guest/dark-secrets"
      }
    },
    "storage-2": {
      "execution": "ssh",
      "management_address": "127.0.0.1",
      "addresses": {
        "lab": "192.168.105.7"
      },
      "ssh": {
        "user": "lmatas",
        "port": 56995,
        "private_key_file": "/Volumes/Externo/dark-lab/.lima/_config/user",
        "known_hosts_file": "/Volumes/Externo/dark-lab/.lima/_config/dark-deployer-known_hosts"
      },
      "paths": {
        "workspace_root": "/home/lmatas.guest/dark",
        "data_root": "/home/lmatas.guest/dark-data",
        "secrets_root": "/home/lmatas.guest/dark-secrets"
      }
    }
  },
  "placement": {
    "apps": "apps",
    "blockchain-a": "blockchain-a",
    "blockchain-b": "blockchain-b",
    "storage-1": "storage-1",
    "storage-2": "storage-2",
    "explorer": "blockchain-a"
  },
  "routing": {
    "blockchain_p2p": "lab",
    "storage_p2p": "lab",
    "storage_api": "lab",
    "application_api": "lab"
  },
  "blockchain": {
    "chain_id": 2025,
    "validator_groups": {
      "blockchain-a": {
        "validator_count": 2
      },
      "blockchain-b": {
        "validator_count": 2
      }
    },
    "observer_groups": {},
    "rpc": {
      "primary": "rpc01",
      "nodes": {
        "rpc01": {
          "group": "apps"
        }
      }
    },
    "artifact": {
      "path": "blockchain/role-artifact"
    }
  },
  "storage": {
    "cluster_name": "dark-lima",
    "peers": {
      "storage-a": {
        "group": "storage-1"
      },
      "storage-b": {
        "group": "storage-2"
      }
    },
    "replication": {
      "publish_after_replicas": 1,
      "target_replicas": 2
    }
  },
  "proxies": {
    "gateway": {
      "group": "apps",
      "listener": {
        "bind": "public",
        "port": 80
      },
      "tls": {
        "mode": "http"
      },
      "sites": [
        {
          "host": "",
          "public_origin": "http://127.0.0.1",
          "routes": [
            {
              "id": "dashboard",
              "path": "/admin/",
              "service": "dashboard",
              "upstream_path": "/"
            },
            {
              "id": "explorer",
              "path": "/explorer/",
              "service": "explorer",
              "upstream_path": "/"
            },
            {
              "id": "minter-v1",
              "path": "/api/v1/",
              "service": "minter-api",
              "upstream_path": "/api/v1/"
            },
            {
              "id": "minter-docs",
              "path": "/api/docs",
              "service": "minter-api",
              "upstream_path": "/docs"
            },
            {
              "id": "minter-openapi",
              "path": "/api/openapi.json",
              "service": "minter-api",
              "upstream_path": "/openapi.json"
            },
            {
              "id": "resolver",
              "path": "/",
              "service": "resolver-api",
              "upstream_path": "/api/v1/arks/"
            }
          ]
        }
      ]
    }
  },
  "overrides": {
    "explorer": {
      "group": "explorer"
    },
    "settings": {
      "minter": {
        "shoulder": "200"
      }
    }
  }
}
