{
  "format": "dark-operator-inventory",
  "format_version": 2,
  "catalog": "dark-standard-1",
  "profile": "lab",
  "deployment": {"id": "dark-operator-local-ha", "label": "dARK local HA simulation"},
  "networks": {"lab": {"kind": "lan", "cidr": "10.99.0.0/24"}},
  "machines": {"local": {"execution": "local"}},
  "placement": {"apps": "local", "blockchain-a": "local", "blockchain-b": "local", "storage-1": "local", "storage-2": "local"},
  "routing": {"blockchain_p2p": "lab", "storage_p2p": "lab", "storage_api": "lab", "application_api": "lab"},
  "blockchain": {
    "chain_id": 2025,
    "validator_groups": {
      "blockchain-a": {"validator_count": 2},
      "blockchain-b": {"validator_count": 2}
    },
    "observer_groups": {},
    "rpc": {"primary": "rpc01", "nodes": {"rpc01": {"group": "apps"}}}
  },
  "storage": {
    "cluster_name": "dark-local",
    "peers": {"storage-a": {"group": "storage-1"}, "storage-b": {"group": "storage-2"}},
    "replication": {"publish_after_replicas": 1, "target_replicas": 2}
  },
  "proxies": {
    "gateway": {
      "group": "apps",
      "listener": {"bind": "loopback", "port": 80},
      "tls": {"mode": "http"},
      "sites": [{"host": "localhost", "public_origin": "http://localhost", "routes": [
        {"id": "dashboard", "path": "/admin/", "service": "dashboard", "upstream_path": "/"},
        {"id": "explorer", "path": "/explorer/", "service": "explorer", "upstream_path": "/"},
        {"id": "minter-v1", "path": "/api/v1/", "service": "minter-api", "upstream_path": "/api/v1/"},
        {"id": "minter-docs", "path": "/api/docs", "service": "minter-api", "upstream_path": "/docs"},
        {"id": "minter-openapi", "path": "/api/openapi.json", "service": "minter-api", "upstream_path": "/openapi.json"},
        {"id": "resolver", "path": "/", "service": "resolver-api", "upstream_path": "/api/v1/arks/"}
      ]}]
    }
  },
  "overrides": {"settings": {"minter": {"shoulder": "200"}}}
}
