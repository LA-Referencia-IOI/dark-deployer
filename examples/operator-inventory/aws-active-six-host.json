{
  "format": "dark-operator-inventory",
  "format_version": 3,
  "catalog": "dark-platform-baseline-v1.0",
  "profile": "production",
  "availability": {
    "objectives": [
      "tolerate_validator_individual",
      "observer_copy"
    ]
  },
  "deployment": {
    "id": "dark-operator-aws-active-six-host",
    "label": "REPLACE: dARK AWS six-host production deployment"
  },
  "defaults": {
    "ssh": {
      "user": "dark",
      "port": 22,
      "private_key_file": "/etc/dark-deployer/ssh/REPLACE-deploy-ed25519"
    },
    "paths": {
      "workspace_root": "/srv/dark",
      "data_root": "/srv/dark/data",
      "secrets_root": "/srv/dark/secrets"
    }
  },
  "networks": {
    "aws-lan": {
      "kind": "lan",
      "cidr": "172.31.0.0/16"
    }
  },
  "sites": {
    "aws": {
      "lan": "aws-lan"
    }
  },
  "machines": {
    "apps": {
      "execution": "ssh",
      "management_address": "172.31.94.30",
      "site": "aws",
      "addresses": {
        "aws-lan": "172.31.94.30"
      }
    },
    "resolver": {
      "execution": "ssh",
      "management_address": "172.31.94.31",
      "site": "aws",
      "addresses": {
        "aws-lan": "172.31.94.31"
      }
    },
    "blockchain-a": {
      "execution": "ssh",
      "management_address": "172.31.94.32",
      "site": "aws",
      "addresses": {
        "aws-lan": "172.31.94.32"
      }
    },
    "blockchain-b": {
      "execution": "ssh",
      "management_address": "172.31.94.33",
      "site": "aws",
      "addresses": {
        "aws-lan": "172.31.94.33"
      }
    },
    "storage-1": {
      "execution": "ssh",
      "management_address": "172.31.94.34",
      "site": "aws",
      "addresses": {
        "aws-lan": "172.31.94.34"
      }
    },
    "storage-2": {
      "execution": "ssh",
      "management_address": "172.31.94.35",
      "site": "aws",
      "addresses": {
        "aws-lan": "172.31.94.35"
      }
    }
  },
  "placement": {
    "apps": "apps",
    "resolver-observer": "resolver",
    "blockchain-a": "blockchain-a",
    "blockchain-b": "blockchain-b",
    "storage-1": "storage-1",
    "storage-2": "storage-2",
    "explorer": "apps"
  },
  "routing": {
    "blockchain_p2p": "aws-lan",
    "storage_p2p": "aws-lan",
    "storage_api": "aws-lan",
    "application_api": "aws-lan"
  },
  "blockchain": {
    "chain_id": 2025,
    "validator_groups": {
      "blockchain-a": {
        "validator_count": 3
      },
      "blockchain-b": {
        "validator_count": 2
      }
    },
    "observer_groups": {
      "resolver-observer": {
        "observer_count": 1
      }
    },
    "rpc": {
      "primary": "rpc01",
      "nodes": {
        "rpc01": {
          "group": "apps"
        }
      },
      "bindings": {
        "resolver-api": "observer01"
      }
    },
    "artifact": {
      "path": "blockchain/role-artifact",
      "source": "REPLACE/secrets/chain-artifact"
    }
  },
  "storage": {
    "cluster_name": "REPLACE-dark-aws-active-six-host",
    "peers": {
      "storage-a": {
        "group": "storage-1"
      },
      "storage-b": {
        "group": "storage-2"
      }
    },
    "replication": {
      "publish_after_replicas": 1,
      "target_replicas": 2
    },
    "readers": {
      "store-api-reader": {
        "group": "resolver-observer",
        "consumers": [
          "resolver-api"
        ]
      }
    }
  },
  "proxies": {
    "resolver-public": {
      "group": "resolver-observer",
      "listener": {
        "bind": "public",
        "port": 80
      },
      "tls": {
        "mode": "external"
      },
      "sites": [
        {
          "host": "resolve.replace.example.org",
          "public_origin": "https://resolve.replace.example.org",
          "routes": [
            {
              "id": "arks",
              "path": "/",
              "service": "resolver-api",
              "upstream_path": "/api/v1/arks/"
            }
          ]
        }
      ]
    },
    "apps-public": {
      "group": "apps",
      "listener": {
        "bind": "public",
        "port": 80
      },
      "tls": {
        "mode": "external"
      },
      "sites": [
        {
          "host": "apps.replace.example.org",
          "public_origin": "https://apps.replace.example.org",
          "routes": [
            {
              "id": "dashboard",
              "path": "/admin/",
              "service": "dashboard",
              "upstream_path": "/"
            },
            {
              "id": "explorer",
              "path": "/explorer/",
              "service": "explorer",
              "upstream_path": "/"
            },
            {
              "id": "minter-v1",
              "path": "/api/v1/",
              "service": "minter-api",
              "upstream_path": "/api/v1/"
            },
            {
              "id": "minter-docs",
              "path": "/api/docs",
              "service": "minter-api",
              "upstream_path": "/docs"
            },
            {
              "id": "minter-openapi",
              "path": "/api/openapi.json",
              "service": "minter-api",
              "upstream_path": "/openapi.json"
            }
          ]
        }
      ]
    }
  },
  "secrets": {
    "source_root": "REPLACE/secrets"
  },
  "overrides": {
    "explorer": {
      "group": "apps"
    },
    "resolver": {
      "group": "resolver-observer"
    },
    "settings": {
      "minter": {
        "shoulder": "200"
      }
    }
  }
}
