{
  "version": 2,
  "deployment": {"id": "dark-local-ha", "private_network": "lab"},
  "defaults": {
    "ssh": {"user": "dark", "port": 22, "private_key_file": "/tmp/not-used-local.key"},
    "paths": {"workspace_root": "/srv/dark", "data_root": "/srv/dark/data", "secrets_root": "/srv/dark/secrets"},
    "docker": {"subnet_pool": "172.30.0.0/16", "subnet_prefix": 24}
  },
  "networks": {"lab": {"kind": "lan", "cidr": "10.99.0.0/24"}},
  "machines": {
    "local": {"execution": "local", "management_address": "127.0.0.1", "addresses": {"lab": "10.99.0.10"}}
  },
  "groups": {
    "apps": {"kind": "apps", "machine": "local", "members": ["rpc01"]},
    "validators-a": {"kind": "validators", "machine": "local", "members": ["validator01", "validator02"], "explorer": true},
    "validators-b": {"kind": "validators", "machine": "local", "members": ["validator03", "validator04"]},
    "storage-a": {"kind": "storage", "machine": "local", "members": ["storage-a"]},
    "storage-b": {"kind": "storage", "machine": "local", "members": ["storage-b"]}
  },
  "blockchain": {
    "chain_id": 2025, "besu_image": "hyperledger/besu:26.6.1",
    "nodes": {"rpc01": {"validator": false}, "validator01": {"validator": true}, "validator02": {"validator": true}, "validator03": {"validator": true}, "validator04": {"validator": true}}
  },
  "storage": {"cluster_name": "dark-local", "nodes": ["storage-a", "storage-b"], "replication": {"publish_after_replicas": 1, "target_replicas": 2}},
  "components": {
    "dark-dapp": {"repository_url": "git@github.com:LA-Referencia-IOI/dark-dapp.git"},
    "dark-explorador": {"repository_url": "git@github.com:LA-Referencia-IOI/dark-explorer.git"},
    "dark-core-lib": {"repository_url": "git@github.com:LA-Referencia-IOI/dark-core-lib.git"},
    "dark-core-admin-api": {"repository_url": "git@github.com:LA-Referencia-IOI/dark-core-admin-api.git"},
    "dark-core-resolver-api": {"repository_url": "git@github.com:LA-Referencia-IOI/dark-core-resolver-api.git"},
    "dark-store-api": {"repository_url": "git@github.com:LA-Referencia-IOI/dark-store-api.git"},
    "dark-core-minter-api": {"repository_url": "git@github.com:LA-Referencia-IOI/dark-core-minter-api.git"},
    "dashboard-web": {"repository_url": "git@github.com:LA-Referencia-IOI/dashboard-web.git"},
    "dark-ipfs": {"repository_url": "git@github.com:LA-Referencia-IOI/dark-ipfs.git"}
  },
  "settings": {},
  "secrets": {
    "master-wallet": {"path": "blockchain/master-wallet", "consumers": ["apps", "chain-bootstrap"]},
    "ipfs-swarm-key": {"path": "ipfs/swarm.key", "consumers": ["storage"]},
    "ipfs-cluster-secret": {"path": "ipfs/cluster.secret", "consumers": ["storage"]},
    "minter-db-password": {"path": "minter/db-password", "consumers": ["apps"]},
    "minter-runtime-env": {"path": "runtime/apps/minter.private.env", "consumers": ["apps"]}
  },
  "exposure": {}
}
