{
  "version": 2,
  "deployment": {"id": "dark-site-a", "private_network": "vpn"},
  "defaults": {
    "ssh": {"user": "dark", "port": 22, "private_key_file": "/opt/dark-controller/deploy.key", "known_hosts_file": "/opt/dark-controller/known_hosts"},
    "paths": {"workspace_root": "/opt/dark", "data_root": "/srv/dark", "secrets_root": "/opt/dark/secrets"},
    "docker": {"subnet_pool": "172.30.0.0/16", "subnet_prefix": 24}
  },
  "networks": {"vpn": {"kind": "vpn", "cidr": "10.20.30.0/24"}},
  "machines": {
    "apps-1": {"execution": "ssh", "management_address": "apps.internal.example", "addresses": {"vpn": "10.20.30.20"}},
    "blockchain-a-1": {"execution": "ssh", "management_address": "blockchain-a.internal.example", "addresses": {"vpn": "10.20.30.10"}},
    "blockchain-b-1": {"execution": "ssh", "management_address": "blockchain-b.internal.example", "addresses": {"vpn": "10.20.30.11"}},
    "storage-1": {"execution": "ssh", "management_address": "storage-1.internal.example", "addresses": {"vpn": "10.20.30.31"}},
    "storage-2": {"execution": "ssh", "management_address": "storage-2.internal.example", "addresses": {"vpn": "10.20.30.32"}}
  },
  "groups": {
    "apps": {"kind": "apps", "machine": "apps-1", "members": ["rpc01"]},
    "validators-a": {"kind": "validators", "machine": "blockchain-a-1", "members": ["validator01", "validator02"], "explorer": true},
    "validators-b": {"kind": "validators", "machine": "blockchain-b-1", "members": ["validator03", "validator04"]},
    "storage-a": {"kind": "storage", "machine": "storage-1", "members": ["storage-a"]},
    "storage-b": {"kind": "storage", "machine": "storage-2", "members": ["storage-b"]}
  },
  "blockchain": {"chain_id": 2025, "besu_image": "hyperledger/besu:26.6.1", "qbft": {"block_period_seconds": 6, "epoch_length": 30000, "request_timeout_seconds": 10}, "artifact": {"path": "blockchain/role-artifact"}, "nodes": {"rpc01": {"validator": false}, "validator01": {"validator": true}, "validator02": {"validator": true}, "validator03": {"validator": true}, "validator04": {"validator": true}}},
  "storage": {"cluster_name": "dark-site-a", "nodes": ["storage-a", "storage-b"], "replication": {"publish_after_replicas": 1, "target_replicas": 2}},
  "components": {
    "dark-dapp": {"repository_url": "git@github.com:LA-Referencia-IOI/dark-dapp.git", "branch": "main"}, "dark-explorador": {"repository_url": "git@github.com:LA-Referencia-IOI/dark-explorer.git", "branch": "main"}, "dark-core-lib": {"repository_url": "git@github.com:LA-Referencia-IOI/dark-core-lib.git", "branch": "main"}, "dark-core-admin-api": {"repository_url": "git@github.com:LA-Referencia-IOI/dark-core-admin-api.git", "branch": "main"}, "dark-core-resolver-api": {"repository_url": "git@github.com:LA-Referencia-IOI/dark-core-resolver-api.git", "branch": "main"}, "dark-store-api": {"repository_url": "git@github.com:LA-Referencia-IOI/dark-store-api.git", "branch": "main"}, "dark-core-minter-api": {"repository_url": "git@github.com:LA-Referencia-IOI/dark-core-minter-api.git", "branch": "main"}, "dashboard-web": {"repository_url": "git@github.com:LA-Referencia-IOI/dashboard-web.git", "branch": "main"}, "dark-ipfs": {"repository_url": "git@github.com:LA-Referencia-IOI/dark-ipfs.git", "branch": "main"}
  },
  "settings": {"minter": {"shoulder": "200", "metadata": {"page_size": 100, "concurrency": 4, "min_concurrency": 2}, "replication": {"enabled": true, "page_size": 100, "concurrency": 2, "status_batch_size": 200, "promotion_batch_size": 100, "promotion_pressure_high_percent": 80, "promotion_pressure_medium_percent": 50, "promotion_min_batch_size": 20, "maintenance_cycle_seconds": 5, "idle_sleep_seconds": 2, "first_pin_recheck_seconds": 15, "first_pin_second_recheck_seconds": 60, "first_pin_max_recheck_seconds": 300, "durability_recheck_seconds": 300, "durability_second_recheck_seconds": 900, "durability_max_recheck_seconds": 3600, "storage_retry_seconds": 10}, "chain": {"page_size": 100, "rpc_batch_size": 50}}, "store": {"add_concurrency": 4, "status_concurrency": 6, "promotion_concurrency": 4}},
  "secrets": {
    "master-wallet": {"path": "blockchain/master-wallet", "consumers": ["apps", "chain-bootstrap"]},
    "contract-signer": {"path": "blockchain/contract-signer", "consumers": ["apps"]},
    "ipfs-swarm-key": {"path": "ipfs/swarm.key", "consumers": ["storage"]},
    "ipfs-cluster-secret": {"path": "ipfs/cluster.secret", "consumers": ["storage"]},
    "minter-db-password": {"path": "minter/db-password", "consumers": ["apps"]},
    "minter-runtime-env": {"path": "runtime/apps/minter.private.env", "consumers": ["apps"]}
    ,"dashboard-runtime-env": {"path": "runtime/apps/dashboard.private.env", "consumers": ["apps"]}
  },
  "exposure": {"services": {"blockchain-rpc": {"bind": "private", "port": 8545}, "admin-api": {"bind": "private", "port": 8000}, "minter-api": {"bind": "private", "port": 8001}, "resolver-api": {"bind": "private", "port": 8002}, "store-api": {"bind": "private", "port": 8003}, "dashboard": {"bind": "private", "port": 8081}, "explorer": {"bind": "private", "port": 25000}}}
}
