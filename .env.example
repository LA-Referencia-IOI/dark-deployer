# Example environment variables
# Copy this file to .env and fill in the values

# Defines which environment/profile to install
# Options: developer | sandbox | production
TYPE=developer

APP_NAME=dark-developer
APP_ENV=development

# Each repository supports the following variables:
#
#   {PREFIX}_{COMPONENT}_REPOSITORY_URL=    Git URL (leave empty to skip the repo entirely)
#   {PREFIX}_{COMPONENT}_REPOSITORY_BRANCH= Branch to clone (default: master)
#   {PREFIX}_{COMPONENT}_SETUP=             True → clone + run COMMANDS / False → clone only
#   {PREFIX}_{COMPONENT}_COMMANDS=          | -separated commands to run when SETUP=True

# ──────────────────────────────────────────────
# GLOBAL BLOCKCHAIN CONFIGURATION
# Used by all components that connect to the chain
# ──────────────────────────────────────────────
CHAIN_ID=1337
RPC_URL=http://localhost:8545
MASTER_WALLET_ADDRESS=0x

# Private key of the deployer wallet (used to deploy dARK smart contracts)
# Required when DEVELOPER_BLOCKCHAIN_DARK_DAPP_SETUP=True
MASTER_PRIVATE_KEY=0x

# ──────────────────────────────────────────────
# DEVELOPER PROFILE
# ──────────────────────────────────────────────

## Blockchain submodules

DEVELOPER_BLOCKCHAIN_DARK_ENV_REPOSITORY_URL=https://github.com/your-org/dark-env
DEVELOPER_BLOCKCHAIN_DARK_ENV_REPOSITORY_BRANCH=master
DEVELOPER_BLOCKCHAIN_DARK_ENV_SETUP=True
DEVELOPER_BLOCKCHAIN_DARK_ENV_COMMANDS=chmod +x setup.sh|chmod +x scripts/*.sh|./setup.sh|docker compose up -d

DEVELOPER_BLOCKCHAIN_DARK_DAPP_REPOSITORY_URL=https://github.com/your-org/dark-DAPP
DEVELOPER_BLOCKCHAIN_DARK_DAPP_REPOSITORY_BRANCH=master
DEVELOPER_BLOCKCHAIN_DARK_DAPP_SETUP=True
DEVELOPER_BLOCKCHAIN_DARK_DAPP_COMMANDS=chmod +x setup.sh|chmod +x scripts/*.sh|./setup.sh|docker compose up -d

DEVELOPER_BLOCKCHAIN_DARK_EXPLORADOR_REPOSITORY_URL=https://github.com/your-org/dark-explorador
DEVELOPER_BLOCKCHAIN_DARK_EXPLORADOR_REPOSITORY_BRANCH=master
DEVELOPER_BLOCKCHAIN_DARK_EXPLORADOR_SETUP=True
DEVELOPER_BLOCKCHAIN_DARK_EXPLORADOR_COMMANDS=docker compose up -d --build|docker compose up -d

## Orchestrator
DEVELOPER_ORCHESTRATOR_REPOSITORY_URL=https://github.com/your-org/dark-orchestrator
DEVELOPER_ORCHESTRATOR_REPOSITORY_BRANCH=master
DEVELOPER_ORCHESTRATOR_SETUP=True
DEVELOPER_ORCHESTRATOR_COMMANDS=chmod +x setup.sh|chmod +x scripts/*.sh|./setup.sh|docker compose up -d

## Resolver
DEVELOPER_RESOLVER_REPOSITORY_URL=https://github.com/your-org/dark-resolver
DEVELOPER_RESOLVER_REPOSITORY_BRANCH=master
DEVELOPER_RESOLVER_SETUP=True
DEVELOPER_RESOLVER_COMMANDS=chmod +x setup.sh|chmod +x scripts/*.sh|./setup.sh|docker compose up -d

## Minter
