TYPE=developer
APP_NAME=dark-developer

# ──────────────────────────────────────────────
# GENERAL PROFILE BLOCKCHAIN CONFIGURATION
# ──────────────────────────────────────────────
CHAIN_ID=2025
RPC_URL=http://localhost:8545
MASTER_WALLET_ADDRESS=0xafc1411d773463ba728016a4a14684f7d7147048
# Private key of the deployer account (used to deploy dARK contracts)
MASTER_PRIVATE_KEY=0x5f99574becb64882ae64acb8740ba68ccbeffdd9908c667d4eec38f9d0def97c
MASTER_PUBLIC_KEY=0xf1cacc9f37663023875b0b44390364bde52aa6f6de4bb43fefd2c8b459eeda175aa30fe637e57ef0b540f7decf6528d9d5ec77f2ff957360ece8033808d9fdc6
# ──────────────────────────────────────────────
# DEVELOPER PROFILE
# ──────────────────────────────────────────────

## Blockchain submodules

DEVELOPER_BLOCKCHAIN_DARK_ENV_REPOSITORY_URL=https://github.com/LA-Referencia-IOI/dark-env
DEVELOPER_BLOCKCHAIN_DARK_ENV_REPOSITORY_BRANCH=master
DEVELOPER_BLOCKCHAIN_DARK_ENV_SETUP=True
DEVELOPER_BLOCKCHAIN_DARK_ENV_COMMANDS=chmod +x setup.sh|chmod +x scripts/*.sh|./setup.sh|docker compose up -d


DEVELOPER_BLOCKCHAIN_DARK_EXPLORADOR_REPOSITORY_URL=https://github.com/LA-Referencia-IOI/dark-explorer.git
DEVELOPER_BLOCKCHAIN_DARK_EXPLORADOR_REPOSITORY_BRANCH=master
DEVELOPER_BLOCKCHAIN_DARK_EXPLORADOR_SETUP=True
DEVELOPER_BLOCKCHAIN_DARK_EXPLORADOR_COMMANDS=docker compose up -d --build|docker compose up -d

DEVELOPER_BLOCKCHAIN_DARK_DAPP_REPOSITORY_URL=https://github.com/LA-Referencia-IOI/dark-dapp
DEVELOPER_BLOCKCHAIN_DARK_DAPP_REPOSITORY_BRANCH=main
DEVELOPER_BLOCKCHAIN_DARK_DAPP_SETUP=True
DEVELOPER_BLOCKCHAIN_DARK_DAPP_COMMANDS=

## Orchestrator
DEVELOPER_ORCHESTRATOR_REPOSITORY_URL=https://github.com/LA-Referencia-IOI/dark-core-orchestrator.git
DEVELOPER_ORCHESTRATOR_REPOSITORY_BRANCH=main
DEVELOPER_ORCHESTRATOR_SETUP=True
DEVELOPER_ORCHESTRATOR_COMMANDS=cp .env.example .env| pip install -r requirements.txt| pip install -e .

## Resolver
DEVELOPER_RESOLVER_REPOSITORY_URL=
DEVELOPER_RESOLVER_REPOSITORY_BRANCH=master
DEVELOPER_RESOLVER_SETUP=False
DEVELOPER_RESOLVER_COMMANDS=chmod +x setup.sh|chmod +x scripts/*.sh|./setup.sh|docker compose up -d

## Minter
DEVELOPER_MINTER_REPOSITORY_URL=
DEVELOPER_MINTER_REPOSITORY_BRANCH=master
DEVELOPER_MINTER_SETUP=False
DEVELOPER_MINTER_COMMANDS=chmod +x setup.sh|chmod +x scripts/*.sh|./setup.sh|docker compose up -d

## IPFS
DEVELOPER_IPFS_REPOSITORY_URL=
DEVELOPER_IPFS_REPOSITORY_BRANCH=master
DEVELOPER_IPFS_SETUP=False
DEVELOPER_IPFS_COMMANDS=chmod +x setup.sh|chmod +x scripts/*.sh|./setup.sh|docker compose up -d

