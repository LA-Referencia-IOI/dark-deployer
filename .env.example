DEVELOPER_CORE_LIB_REPOSITORY_BRANCH=main
DEVELOPER_CORE_LIB_SETUP=True
DEVELOPER_CORE_LIB_COMMANDS_JSON=[]

## Core Admin API
DEVELOPER_CORE_ADMIN_API_REPOSITORY_URL=git@github.com:LA-Referencia-IOI/dark-core-admin-api.git
DEVELOPER_CORE_ADMIN_API_REPOSITORY_BRANCH=main
DEVELOPER_CORE_ADMIN_API_SETUP=True
