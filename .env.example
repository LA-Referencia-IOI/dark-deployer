## Decoupled infrastructure
#
# The install.py wizard NEVER prompts you to type any of the values below —
# it only asks you to pick from a menu (profile, role, blockchain placement).
# Fill in whatever your selection needs BEFORE running the wizard: copy the
# public '.env.integration' plus the apps-only '.env.integration.secrets'
# handoff files into this directory, or set the fields directly here. If a
# required field is missing for your selection, the wizard lists exactly
# which ones and exits — it does not fall back to asking interactively.
# See README.md and docs/ipfs-architecture.md for the full field reference.

# Which components to install on this server: all | apps | blockchain | storage-node
SANDBOX_INSTALL_COMPONENTS=all

# Blockchain tier — set BLOCKCHAIN_HOST to skip local blockchain install (remote tier).
# Remote requires RPC_URL, *_DARK_CONTRACT_ADDRESS, *_AUTHORITY_CONTRACT_ADDRESS and
# ADMIN_PRIVATE_KEY and MINTER_PRIVATE_KEY to be set (handoff files or below).
SANDBOX_BLOCKCHAIN_HOST=
SANDBOX_BLOCKCHAIN_EXTRA_NODES=
SANDBOX_BLOCKCHAIN_ENODES=

# Contract addresses — required when blockchain tier is remote.
# On local installs these are read from deployed_contracts.ini automatically.
SANDBOX_DARK_CONTRACT_ADDRESS=
SANDBOX_AUTHORITY_CONTRACT_ADDRESS=

# Every apps host runs its own Store API against both storage nodes in this site.
SANDBOX_STORAGE_TOPOLOGY_FILE=storage-topology.json
SANDBOX_STORAGE_SITE_ID=site-a
# The next three fields are required only for the storage-node role.
SANDBOX_STORAGE_NODE_ID=site-a-storage-1
SANDBOX_IPFS_SWARM_KEY_FILE=/absolute/secret/path/ipfs-swarm.key
SANDBOX_IPFS_CLUSTER_SECRET_FILE=/absolute/secret/path/ipfs-cluster-secret
SANDBOX_STORE_API_URL=

