# Example environment variables
# Copy this file to .env and fill in the values

# Defines which environment/profile to install
# Options: developer | sandbox | production
TYPE=developer

APP_NAME=dark-developer
APP_ENV=development

# ──────────────────────────────────────────────
# DEVELOPER PROFILE
# ──────────────────────────────────────────────

## Blockchain submodules
DEVELOPER_BLOCKCHAIN_DARK_ENV_REPOSITORY_URL=https://github.com/your-org/dark-env
DEVELOPER_BLOCKCHAIN_DARK_ENV_REPOSITORY_BRANCH=master

DEVELOPER_BLOCKCHAIN_DARK_ADPP_REPOSITORY_URL=https://github.com/your-org/dark-adpp
DEVELOPER_BLOCKCHAIN_DARK_ADPP_REPOSITORY_BRANCH=master

DEVELOPER_BLOCKCHAIN_DARK_EXPLORADOR_REPOSITORY_URL=https://github.com/your-org/dark-explorador
DEVELOPER_BLOCKCHAIN_DARK_EXPLORADOR_REPOSITORY_BRANCH=master

## Orchestrator
DEVELOPER_ORCHESTRATOR_REPOSITORY_URL=https://github.com/your-org/dark-orchestrator
DEVELOPER_ORCHESTRATOR_REPOSITORY_BRANCH=master

## Resolver
DEVELOPER_RESOLVER_REPOSITORY_URL=https://github.com/your-org/dark-resolver
DEVELOPER_RESOLVER_REPOSITORY_BRANCH=master

## Minter
DEVELOPER_MINTER_REPOSITORY_URL=https://github.com/your-org/dark-minter
DEVELOPER_MINTER_REPOSITORY_BRANCH=master

## IPFS
DEVELOPER_IPFS_REPOSITORY_URL=https://github.com/your-org/dark-ipfs
DEVELOPER_IPFS_REPOSITORY_BRANCH=master

