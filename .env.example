TYPE=developer
APP_NAME=dark-developer

# ──────────────────────────────────────────────
# GENERAL PROFILE BLOCKCHAIN CONFIGURATION
# ──────────────────────────────────────────────
CHAIN_ID=
# In a decoupled setup (apps server ≠ blockchain server) set this to the
# blockchain server's external URL, e.g. http://192.168.1.10:8545
RPC_URL=
MASTER_WALLET_ADDRESS=
# Never commit a real private key. Local blockchain installs populate these
# wallet fields automatically. *_PRIVATE_KEY_FILE may point to a raw secret
# mounted by Docker/Kubernetes/Vault. MASTER_PRIVATE_KEY is legacy fallback.
MASTER_PRIVATE_KEY=
MASTER_PUBLIC_KEY=
DEPLOYER_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY_FILE=
ADMIN_PRIVATE_KEY=
ADMIN_PRIVATE_KEY_FILE=
MINTER_PRIVATE_KEY=
MINTER_PRIVATE_KEY_FILE=
