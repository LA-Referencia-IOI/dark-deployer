TYPE=developer
APP_NAME=dark-developer

# ──────────────────────────────────────────────
# GENERAL PROFILE BLOCKCHAIN CONFIGURATION
# ──────────────────────────────────────────────
CHAIN_ID=
# In a decoupled setup (apps server ≠ blockchain server) set this to the
# blockchain server's external URL, e.g. http://192.168.1.10:8545
RPC_URL=
MASTER_WALLET_ADDRESS=
# Never commit a real private key. Local blockchain installs populate these
# wallet fields automatically. *_PRIVATE_KEY_FILE may point to a raw secret
# mounted by Docker/Kubernetes/Vault. MASTER_PRIVATE_KEY is legacy fallback.
MASTER_PRIVATE_KEY=
MASTER_PUBLIC_KEY=
# Production V1 uses one platform signer for deployment, Admin and Minter.
# The key file must be absolute and mode 0600; never put its contents here.
SIGNER_MODE=legacy
PLATFORM_PRIVATE_KEY_FILE=
PLATFORM_ADDRESS=
# Production host bundles require this checkout to use the configured branch.
DEPLOYER_BRANCH=main
DEPLOYER_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY_FILE=
ADMIN_PRIVATE_KEY=
ADMIN_PRIVATE_KEY_FILE=
MINTER_PRIVATE_KEY=
MINTER_PRIVATE_KEY_FILE=

# IPFS replication reconciliation runs as a process separate from metadata and chain.
REPLICATION_WORKER_ENABLED=true
REPLICATION_WORKER_PAGE_SIZE=50
REPLICATION_WORKER_CONCURRENCY=2
REPLICATION_WORKER_SLEEP_SECONDS=30
REPLICATION_WORKER_RECHECK_SECONDS=300
REPLICATION_WORKER_STORAGE_RETRY_SECONDS=10
REPLICATION_WORKER_RUNTIME_NAME=replication-reconciler
# ──────────────────────────────────────────────
# DEVELOPER PROFILE
# ──────────────────────────────────────────────

## Blockchain submodules

DEVELOPER_BLOCKCHAIN_DARK_ENV_REPOSITORY_URL=git@github.com:LA-Referencia-IOI/dark-env.git
DEVELOPER_BLOCKCHAIN_DARK_ENV_REPOSITORY_BRANCH=main
DEVELOPER_BLOCKCHAIN_DARK_ENV_SETUP=True
DEVELOPER_BLOCKCHAIN_DARK_ENV_COMMANDS_JSON=["chmod +x setup.sh","chmod +x scripts/*.sh","./setup.sh","docker compose up -d"]


DEVELOPER_BLOCKCHAIN_DARK_EXPLORADOR_REPOSITORY_URL=git@github.com:LA-Referencia-IOI/dark-explorer.git
DEVELOPER_BLOCKCHAIN_DARK_EXPLORADOR_REPOSITORY_BRANCH=main
DEVELOPER_BLOCKCHAIN_DARK_EXPLORADOR_SETUP=True
DEVELOPER_BLOCKCHAIN_DARK_EXPLORADOR_COMMANDS_JSON=["docker compose up -d --build","docker compose up -d"]

DEVELOPER_BLOCKCHAIN_DARK_DAPP_REPOSITORY_URL=git@github.com:LA-Referencia-IOI/dark-dapp.git
DEVELOPER_BLOCKCHAIN_DARK_DAPP_REPOSITORY_BRANCH=main
DEVELOPER_BLOCKCHAIN_DARK_DAPP_SETUP=True
DEVELOPER_BLOCKCHAIN_DARK_DAPP_COMMANDS_JSON=[]

## Core Lib
DEVELOPER_CORE_LIB_REPOSITORY_URL=git@github.com:LA-Referencia-IOI/dark-core-lib.git
DEVELOPER_CORE_LIB_REPOSITORY_BRANCH=main
DEVELOPER_CORE_LIB_SETUP=True
DEVELOPER_CORE_LIB_COMMANDS_JSON=[]

## Core Admin API
DEVELOPER_CORE_ADMIN_API_REPOSITORY_URL=git@github.com:LA-Referencia-IOI/dark-core-admin-api.git
DEVELOPER_CORE_ADMIN_API_REPOSITORY_BRANCH=main
DEVELOPER_CORE_ADMIN_API_SETUP=True
DEVELOPER_CORE_ADMIN_API_COMMANDS_JSON=[]

## Store API
DEVELOPER_STORE_API_REPOSITORY_URL=git@github.com:LA-Referencia-IOI/dark-store-api.git
DEVELOPER_STORE_API_REPOSITORY_BRANCH=main
DEVELOPER_STORE_API_SETUP=True
DEVELOPER_STORE_API_COMMANDS_JSON=[]

## Resolver
DEVELOPER_RESOLVER_REPOSITORY_URL=git@github.com:LA-Referencia-IOI/dark-core-resolver-api.git
DEVELOPER_RESOLVER_REPOSITORY_BRANCH=main
DEVELOPER_RESOLVER_SETUP=True
DEVELOPER_RESOLVER_COMMANDS_JSON=[]

## Minter
DEVELOPER_MINTER_REPOSITORY_URL=git@github.com:LA-Referencia-IOI/dark-core-minter-api.git
DEVELOPER_MINTER_REPOSITORY_BRANCH=main
DEVELOPER_MINTER_SETUP=True
DEVELOPER_MINTER_COMMANDS_JSON=[]
# DARK 2 shoulder: 2 = version, final two digits identify this minter.
DEVELOPER_MINTER_SHOULDER=200

## IPFS
DEVELOPER_IPFS_REPOSITORY_URL=git@github.com:LA-Referencia-IOI/dark-ipfs.git
DEVELOPER_IPFS_REPOSITORY_BRANCH=main
DEVELOPER_IPFS_SETUP=True
DEVELOPER_IPFS_COMMANDS_JSON=["make up"]

## Global storage topology
# Roles: all | apps | blockchain | storage-node
# The developer wizard offers simple (one peer) and ha (two peers in one site),
# and creates the selected topology plus both secret files when absent.
# The single-peer topology is rejected by sandbox and production profiles.
DEVELOPER_INSTALL_COMPONENTS=all
DEVELOPER_STORAGE_MODE=simple
DEVELOPER_STORAGE_TOPOLOGY_FILE=storage-topology.json
DEVELOPER_STORAGE_SITE_ID=site-a
# Required only when this server has the storage-node role.
DEVELOPER_STORAGE_NODE_ID=site-a-storage-1
DEVELOPER_IPFS_SWARM_KEY_FILE=/absolute/secret/path/ipfs-swarm.key
DEVELOPER_IPFS_CLUSTER_SECRET_FILE=/absolute/secret/path/ipfs-cluster-secret

## Dashboard
DEVELOPER_DASHBOARD_REPOSITORY_URL=git@github.com:LA-Referencia-IOI/dashboard-web.git
DEVELOPER_DASHBOARD_REPOSITORY_BRANCH=main
DEVELOPER_DASHBOARD_SETUP=True
DEVELOPER_DASHBOARD_COMMANDS_JSON=["python3 install.py"]

