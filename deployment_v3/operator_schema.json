{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dARK operator inventory",
  "type": "object",
  "required": ["format", "format_version", "catalog", "deployment", "machines", "placement", "blockchain", "storage"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "dark-operator-inventory"},
    "format_version": {"enum": [2, 3]},
    "catalog": {"const": "dark-platform-baseline-v1.0"},
    "deployment": {"type": "object"},
    "profile": {"enum": ["local", "lab", "production"]},
    "defaults": {"type": "object"},
    "networks": {"type": "object"},
    "sites": {"type": "object"},
    "routes": {"type": "array"},
    "machines": {"type": "object", "minProperties": 1},
    "placement": {"type": "object", "minProperties": 1},
    "routing": {"type": "object"},
    "networking": {"type": "object"},
    "blockchain": {"type": "object"},
    "storage": {"type": "object"},
    "proxies": {"type": "object"},
    "access": {"type": "object"},
    "secrets": {"type": "object"},
    "overrides": {"type": "object"},
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectives"],
      "properties": {
        "objectives": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["tolerate_validator_individual", "tolerate_validator_group", "tolerate_machine", "observer_copy", "rpc_redundant", "storage_durable"]}
        },
        "acknowledgements": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["tolerate_validator_individual", "tolerate_validator_group", "tolerate_machine", "observer_copy", "rpc_redundant", "storage_durable"]}
        }
      }
    }
  }
}
