{
  "version": 1,
  "environment": "production",
  "deployment": {
    "id": "dark-site-a-1",
    "deployer_branch": "main",
    "ssh": {
      "user": "dark",
      "port": 22,
      "private_key_file": "/opt/dark-deployer/secrets/deploy.key",
      "remote_directory": "/opt/dark-deployer"
    }
  },
  "chain_id": 2025,
  "network": {"trust_boundary": "vpn", "vpn_cidr": "10.20.30.0/24", "trusted_minter_clients": ["10.20.30.50/32"]},
  "signing": {"mode": "shared", "platform_key_target": "/opt/dark-deployer/secrets/platform.key"},
  "blockchain": {"besu_image": "hyperledger/besu:26.6.1", "chain_artifact_target": "/opt/dark-deployer/secrets/chain-artifact"},
  "storage": {
    "cluster_name": "dark-site-a",
    "replication": {"publish_after_replicas": 1, "target_replicas": 2},
    "nodes": [{"id": "storage-a", "address": "10.20.30.31"}, {"id": "storage-b", "address": "10.20.30.32"}],
    "access_groups": {"apps-a": ["storage-a", "storage-b"]},
    "swarm_key_target": "/opt/dark-deployer/secrets/ipfs-swarm.key",
    "cluster_secret_target": "/opt/dark-deployer/secrets/ipfs-cluster-secret"
  },
  "components": {
    "dark-dapp": {"repository_url": "git@github.com:LA-Referencia-IOI/dark-dapp.git", "branch": "main"},
    "dark-explorador": {"repository_url": "git@github.com:LA-Referencia-IOI/dark-explorer.git", "branch": "main"},
    "dark-core-lib": {"repository_url": "git@github.com:LA-Referencia-IOI/dark-core-lib.git", "branch": "main"},
    "dark-core-admin-api": {"repository_url": "git@github.com:LA-Referencia-IOI/dark-core-admin-api.git", "branch": "main"},
    "dark-core-resolver-api": {"repository_url": "git@github.com:LA-Referencia-IOI/dark-core-resolver-api.git", "branch": "main"},
    "dark-store-api": {"repository_url": "git@github.com:LA-Referencia-IOI/dark-store-api.git", "branch": "main"},
    "dark-core-minter-api": {"repository_url": "git@github.com:LA-Referencia-IOI/dark-core-minter-api.git", "branch": "main"},
    "dashboard-web": {"repository_url": "git@github.com:LA-Referencia-IOI/dashboard-web.git", "branch": "main"},
    "dark-ipfs": {"repository_url": "git@github.com:LA-Referencia-IOI/dark-ipfs.git", "branch": "main"}
  },
  "hosts": [
    {"id": "site-a-apps-1", "role": "apps", "management_address": "apps.internal.example", "vpn_address": "10.20.30.20", "storage_access_group": "apps-a", "blockchain_data_root": "/srv/dark/blockchain"},
    {"id": "site-a-blockchain-a-1", "role": "blockchain-a", "management_address": "blockchain-a.internal.example", "vpn_address": "10.20.30.10", "blockchain_data_root": "/srv/dark/blockchain"},
    {"id": "site-a-blockchain-b-1", "role": "blockchain-b", "management_address": "blockchain-b.internal.example", "vpn_address": "10.20.30.11", "blockchain_data_root": "/srv/dark/blockchain"},
    {"id": "site-a-storage-1", "role": "storage-node", "management_address": "ipfs-1.internal.example", "vpn_address": "10.20.30.31", "storage_node_id": "storage-a", "storage_data_root": "/srv/dark/storage"},
    {"id": "site-a-storage-2", "role": "storage-node", "management_address": "ipfs-2.internal.example", "vpn_address": "10.20.30.32", "storage_node_id": "storage-b", "storage_data_root": "/srv/dark/storage"}
  ]
}
